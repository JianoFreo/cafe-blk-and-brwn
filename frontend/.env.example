# The address of your BACKEND api, including /api (the frontend and backend are hosted separately).
# Set this in your frontend host's environment variables BEFORE building, e.g. on Netlify / Vercel / Render Static.
# Leave it empty for local development (Vite forwards /api to http://localhost:5000).
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
