# --- required ---
# Neon connection string (https://neon.tech)  ->  postgresql://user:pass@host/db?sslmode=require
# Or, to try everything locally with no account:  pglite://./.data
DATABASE_URL=
# any long random text (16+ characters)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- your first admin account (created once, when the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Site Administrator
# ADMIN_EMAIL=            # optional, only saved on the account record (never used to log in or to send mail)

# --- Cloudinary (image uploads)  https://cloudinary.com/console ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cafe-blk-and-brwn

# --- hosting ---
NODE_ENV=development
PORT=5000
# The address of your WEBSITE (the frontend), so the browser is allowed to call this API.
# Leave empty in local development (Vite proxies /api). On Render set it, e.g. https://cafe.netlify.app
# Several addresses: separate with commas. No trailing slash needed.
CLIENT_URL=
