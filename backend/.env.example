# --- required ---
# Neon connection string (https://neon.tech)  ->  postgresql://user:pass@host/db?sslmode=require
# Or, to try everything locally with no account:  pglite://./.data
DATABASE_URL=
# any long random text (16+ characters)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- your first admin account (created once, when the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Site Administrator
ADMIN_EMAIL=

# --- Cloudinary (image uploads)  https://cloudinary.com/console ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cafe-blk-and-brwn

# --- optional ---
NODE_ENV=development
PORT=5000
# only if the frontend is hosted on a different address than this server
CLIENT_URL=
